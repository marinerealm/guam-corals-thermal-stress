cff-version: 1.2.0
title: "Thermal stress experiment on three Guam corals, March 2025"
message: "If you use these data or code, please cite the accompanying manuscript."
type: dataset
authors:
  - given-names: Gaurav
    name-particle: G.
    family-names: Shimpi
    email: nature.gaurav@gmail.com
